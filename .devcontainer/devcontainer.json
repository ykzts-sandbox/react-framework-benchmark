{
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "customizations": {
    "vscode": {
      "settings": {},
      "extensions": [
        "oxc.oxc-vscode"
      ]
    }
  },
  "features": {
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {},
    "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/github-cli:1.1.3": {}
  },
  "image": "mcr.microsoft.com/devcontainers/typescript-node:4.0.10-24-trixie@sha256:0cbad76d1987fd35fd78cbc58cbe8c2aa93a8daa45411e52c6c6b63ea2dae202",
  "mounts": [
    "source=react-framework-benchmark-claude-home-${devcontainerId},target=/home/node/.claude,type=volume",
    "source=react-framework-benchmark-gh-config-${devcontainerId},target=/home/node/.config/gh,type=volume",
    "source=react-framework-benchmark-grok-home-${devcontainerId},target=/home/node/.grok,type=volume",
    "source=react-framework-benchmark-local-bin-${devcontainerId},target=/home/node/.local/bin,type=volume"
  ],
  "name": "React Framework Benchmark Dev",
  "postCreateCommand": ".devcontainer/post-create.sh"
}